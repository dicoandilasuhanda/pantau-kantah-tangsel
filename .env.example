# Konfigurasi Environment Produksi & Docker Compose (jangan commit file .env asli ke Git!)
# Salin berkas ini menjadi .env di root direktori server produksi QNAP:
#   cp .env.example .env

# 1. Secret penandatangan JWT sesi pengguna & QR Code baru (WAJIB acak >= 32 karakter di production)
# Contoh generate: openssl rand -hex 32
JWT_SECRET=GANTI_DENGAN_JWT_SECRET_ACAK_MINIMAL_32_KARAKTER

# 2. Konfigurasi Bot Telegram notifikasi transit & status backup
# Kosongkan jika bot Telegram belum diaktifkan (polling otomatis nonaktif)
TELEGRAM_BOT_TOKEN=GANTI_DENGAN_TOKEN_BOT_TELEGRAM_ANDA
TELEGRAM_BOT_USERNAME=pantaukantahtangsel_bot

# 3. Token Cloudflare Tunnel resmi untuk layanan cloudflared (wajib diisi di host produksi)
CLOUDFLARE_TUNNEL_TOKEN=GANTI_DENGAN_TOKEN_CLOUDFLARE_TUNNEL_ANDA
