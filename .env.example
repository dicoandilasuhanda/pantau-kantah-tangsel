# Konfigurasi Docker Compose Host (jangan commit file .env asli ke Git!)
# Salin berkas ini menjadi .env di root direktori server produksi QNAP:
#   cp .env.example .env

# Token Cloudflare Tunnel resmi untuk layanan cloudflared (wajib diisi di host produksi)
CLOUDFLARE_TUNNEL_TOKEN=GANTI_DENGAN_TOKEN_CLOUDFLARE_TUNNEL_ANDA
